{
  "name": "dsh-agy-mode",
  "version": "0.4.4",
  "type": "module",
  "description": "DSH agent mode where the local Antigravity CLI plans, reviews and signs off on quality while DSH executes. Three cost tiers, conversation reuse, diff-first review, an enforced quality gate, a delegation budget, and model/effort choices set on the plugin page.",
  "license": "MIT",
  "author": "fuyu1993",
  "homepage": "https://github.com/fuyu1993/dsh-agy-mode#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-preset",
    "antigravity",
    "agy",
    "gemini",
    "quality-gate",
    "review",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuyu1993/dsh-agy-mode.git"
  },
  "bugs": {
    "url": "https://github.com/fuyu1993/dsh-agy-mode/issues"
  },
  "main": "./config.js",
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test",
    "release": "scripts/release.sh",
    "release:check": "scripts/release.sh --dry-run"
  },
  "exports": {
    ".": "./config.js",
    "./planner": "./index.js",
    "./config": "./config.js",
    "./config-model": "./config-model.js",
    "./config-runtime": "./config-runtime.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "scripts",
    "README.md",
    "LICENSE",
    "index.js",
    "config.js",
    "config-model.js",
    "config-runtime.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "package.json"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
